  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#belongsToFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">belongs to family</rdfs:label>
    <rdfs:comment xml:lang="en">Links a plant to its taxonomic family. Functional (one family per plant). Can be inferred via: belongsToGenus ∘ isSubsumedByFamily ⊑ belongsToFamily.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Family"/>
    <owl:propertyChainAxiom rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb65"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#hasFamilyMember"/>
  </rdf:Description>
