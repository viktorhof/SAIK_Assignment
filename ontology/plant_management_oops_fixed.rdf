  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#growthRateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#GrowthRate"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:label xml:lang="en">growth rate of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of hasGrowthRate.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#VegetableUse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vegetable Use</rdfs:label>
    <rdfs:comment xml:lang="en">Plant classified as a vegetable. Maps to CSV 'vegetable' = true.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantUse"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasFamilyMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
