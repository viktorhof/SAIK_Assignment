    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb103">
    <rdf:first rdf:resource="http://www.semanticweb.org/plantms/ontology#November"/>
    <rdf:rest rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb104"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasCareLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has care level</rdfs:label>
    <rdfs:comment xml:lang="en">Care difficulty of this shop product (Easy/Medium/Hard).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#ShopProduct"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#CareLevel"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#careLevelOfProduct"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasPhMinimum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has pH minimum</rdfs:label>
    <rdfs:comment xml:lang="en">Minimum soil pH. Range [0.0, 14.0]. Maps to CSV 'ph_minimum'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb35"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasSoilNutriments">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has soil nutriments</rdfs:label>
    <rdfs:comment xml:lang="en">Soil nutriment requirement (0–10). Maps to CSV 'soil_nutriments'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb52"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#EdibleUse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Edible Use</rdfs:label>
    <rdfs:comment xml:lang="en">Plant used as a food source. Maps to CSV 'edible' = true.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantUse"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#Root">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Root</rdfs:label>
    <rdfs:comment xml:lang="en">Root system of a plant. Has minimum_root_depth_cm.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#RapidGrowthRate">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#GrowthRate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Rapid</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#plantUseOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantUse"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:label xml:lang="en">plant use of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of hasPlantUse.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#FlowerColor_Purple">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#FlowerColor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Purple</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasShopProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has shop product</rdfs:label>
    <rdfs:comment xml:lang="en">Links a plant species to its shop product line(s). A species can have multiple shop entries (e.g. different pot sizes).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#ShopProduct"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#isShopProductFor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#isComponentOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is component of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of hasComponent.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantPart"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#EdibleRootsUse">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#EdibleUse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Edible Roots</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#isSubRegionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">is sub-region of</rdfs:label>
    <rdfs:comment xml:lang="en">Transitive region hierarchy: Country isSubRegionOf Continent.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Region"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Region"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#hasSubRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#July">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#Month"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">July</rdfs:label>
    <plant:inSeason rdf:resource="http://www.semanticweb.org/plantms/ontology#Summer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#Flower">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Flower</rdfs:label>
    <rdfs:comment xml:lang="en">Flower of a plant. Has color (flower_color) and conspicuousness (flower_conspicuous).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#foliageTextureOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#FoliageTexture"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Foliage"/>
    <rdfs:label xml:lang="en">foliage texture of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of hasFoliageTexture.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#inRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">in region</rdfs:label>
    <rdfs:comment xml:lang="en">Links a PlantDistribution node to its geographic Region.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantDistribution"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Region"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#regionOfDistribution"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb83">
