  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#PlantUse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Plant Use</rdfs:label>
    <rdfs:comment xml:lang="en">Abstract superclass for plant use roles (AgentRole ODP). A plant points to PlantUse individuals rather than inheriting use subclasses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#FruitColor_Black">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#FruitColor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Black</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb120">
    <rdf:first rdf:resource="http://www.semanticweb.org/plantms/ontology#Family"/>
    <rdf:rest rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb121"/>
