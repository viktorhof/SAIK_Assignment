<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:plant="http://www.semanticweb.org/plantms/ontology#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasFoliageTexture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has foliage texture</rdfs:label>
    <rdfs:comment xml:lang="en">Texture of foliage (fine/medium/coarse). Maps to CSV 'foliage_texture'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Foliage"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#FoliageTexture"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#foliageTextureOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb8">
    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:maxInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#Shrub">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#GrowthHabit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Shrub</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#September">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#Month"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">September</rdfs:label>
    <plant:inSeason rdf:resource="http://www.semanticweb.org/plantms/ontology#Autumn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#Region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Region</rdfs:label>
    <rdfs:comment xml:lang="en">Abstract geographic region. Subclassed into Continent and Country.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#OrnamentalUse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ornamental Use</rdfs:label>
    <rdfs:comment xml:lang="en">Plant used for decorative / ornamental purposes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantUse"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb20">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#June">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#Month"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">June</rdfs:label>
    <plant:inSeason rdf:resource="http://www.semanticweb.org/plantms/ontology#Summer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasGroundHumidity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has ground humidity</rdfs:label>
    <rdfs:comment xml:lang="en">Ground humidity requirement (0–10). Maps to CSV 'ground_humidity'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb14"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#GrowthHabit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Growth Habit</rdfs:label>
    <rdfs:comment xml:lang="en">Overall growth habit of a plant (Tree, Shrub, Vine, etc.). CSV 'growth_habit' is comma-separated; a plant can have multiple.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:disjointUnionOf rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb83"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#belongsToGenus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">belongs to genus</rdfs:label>
    <rdfs:comment xml:lang="en">Links a plant to its taxonomic genus. Maps to CSV column 'genus'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Genus"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#hasGenusMember"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasShelfDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has shelf date</rdfs:label>
    <rdfs:comment xml:lang="en">Date the product arrived on the shop shelf (xsd:date). Used to identify products sitting &gt;3 months.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#ShopProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasAuthor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has author</rdfs:label>
    <rdfs:comment xml:lang="en">Author of the taxonomic description. Maps to CSV 'author'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#PlantPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Plant Part</rdfs:label>
    <rdfs:comment xml:lang="en">Abstract superclass for structural plant components. Supports the Componency ODP.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb92"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#requiresCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">requires condition</rdfs:label>
    <rdfs:comment xml:lang="en">Abstract link from a plant to an ecological condition type. Numeric condition values are also expressed as datatype properties.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#HabitatCondition"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#conditionRequiredBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#FoliageColor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Foliage Color</rdfs:label>
    <rdfs:comment xml:lang="en">Color of foliage (e.g. Green, Grey).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/plantms/ontology#Color"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasGenusMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Genus"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:label xml:lang="en">has genus member</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of belongsToGenus.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#FlowerColor_Black">
    <rdf:type rdf:resource="http://www.semanticweb.org/plantms/ontology#FlowerColor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Black</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasMinimumRootDepthCm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has minimum root depth (cm)</rdfs:label>
    <rdfs:comment xml:lang="en">Minimum root depth in centimetres. Maps to CSV 'minimum_root_depth_cm'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb27"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb111">
    <rdf:first rdf:resource="http://www.semanticweb.org/plantms/ontology#Flower"/>
    <rdf:rest rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb112"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#Month">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Month</rdfs:label>
    <rdfs:comment xml:lang="en">Calendar month. 12 named individuals (January–December). Used by bloomsInMonth, fruitingInMonth, growsInMonth.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:disjointUnionOf rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb93"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#isFruitingMonthOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Month"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:label xml:lang="en">is fruiting month of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of fruitingInMonth.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb94">
    <rdf:first rdf:resource="http://www.semanticweb.org/plantms/ontology#February"/>
    <rdf:rest rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb95"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb45">
