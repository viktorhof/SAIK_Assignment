    <rdfs:label xml:lang="en">is shop product for</rdfs:label>
    <rdfs:comment xml:lang="en">Links a shop product to its plant species. Functional: one species per product. inverseOf hasShopProduct.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#ShopProduct"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
