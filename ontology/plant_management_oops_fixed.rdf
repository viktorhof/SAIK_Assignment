    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#hasMonth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#isSubsumedByFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is subsumed by family</rdfs:label>
    <rdfs:comment xml:lang="en">Links a genus to its parent family. Enables the property chain axiom.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Genus"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Family"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#hasGenus"/>
  </rdf:Description>
