    <rdf:rest rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb84"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb40">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
