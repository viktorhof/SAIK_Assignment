    <rdfs:label xml:lang="en">Season</rdfs:label>
    <rdfs:comment xml:lang="en">Season of the year: Spring, Summer, Autumn, Winter.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:disjointUnionOf rdf:nodeID="n4b614ebc42db42a6b30571eb5c32258fb75"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#Foliage">
