    <rdfs:label xml:lang="en">has family member</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of belongsToFamily.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasColor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has color</rdfs:label>
    <rdfs:comment xml:lang="en">Links a plant part (Flower, Foliage, Fruit) to a Color individual. Type-safe via subclasses FlowerColor, FoliageColor, FruitColor.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantPart"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#Color"/>
