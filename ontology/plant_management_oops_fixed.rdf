    <rdfs:label xml:lang="en">is growth month of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of growsInMonth.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#FruitColor_Red">
