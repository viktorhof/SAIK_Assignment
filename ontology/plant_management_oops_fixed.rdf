    <rdfs:label xml:lang="en">Foliage</rdfs:label>
    <rdfs:comment xml:lang="en">Leaves/foliage of a plant. Has color (foliage_color) and texture (foliage_texture).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#isGrowthMonthOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
