    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Taxonomic Rank</rdfs:label>
    <rdfs:comment xml:lang="en">Abstract superclass for taxonomic classification units (Family, Genus). Enables the property chain belongsToGenus∘isSubsumedByFamily ⊑ belongsToFamily.</rdfs:comment>
