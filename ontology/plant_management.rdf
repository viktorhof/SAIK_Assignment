  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantPart"/>
    <rdfs:label xml:lang="en">has component</rdfs:label>
    <rdfs:comment xml:lang="en">Direct (non-transitive) structural component. hasComponent subPropertyOf hasPart. Plant hasComponent Flower — i.e. this plant HAS a flower.</rdfs:comment>
