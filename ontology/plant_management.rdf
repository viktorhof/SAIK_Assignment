  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#isEdible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">is edible</rdfs:label>
    <rdfs:comment xml:lang="en">True if the plant is edible. Maps to CSV 'edible'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#Plant"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/plantms/ontology#PlantPart"/>
    <rdfs:label xml:lang="en">has part</rdfs:label>
    <rdfs:comment xml:lang="en">Transitive part-of relation. Plant hasPart PlantPart (and all sub-parts). Supports the Componency ODP.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/plantms/ontology#isPartOf"/>
    <owl:propertyChainAxiom rdf:nodeID="N08e8f887270145eea5d777f2d115cc60"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasProductName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/plantms/ontology#ShopProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has product name</rdfs:label>
    <rdfs:comment xml:lang="en">Commercial name used in the shop (e.g. 'Monstera', 'Peace Lily').</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#hasPriceEur">
