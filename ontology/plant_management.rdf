    <rdfs:label xml:lang="en">has image URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of a representative plant image. Maps to CSV 'image_url'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/plantms/ontology#GrowthHabit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Growth Habit</rdfs:label>
    <rdfs:comment xml:lang="en">Overall growth habit of a plant (Tree, Shrub, Vine, etc.). CSV 'growth_habit' is comma-separated; a plant can have multiple.</rdfs:comment>
