<#RegionTriplesMap>
  rr:logicalTable [ rr:tableName "region" ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/region/{region_id}";
    rr:class plant:Region
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [ rr:column "region_name" ]
  ] .

<#PlantDistributionTriplesMap>
  rr:logicalTable [ rr:tableName "plant_distribution" ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/distribution/{plant_id}/{region_id}";
    rr:class plant:PlantDistribution
  ];
  rr:predicateObjectMap [
    rr:predicate plant:distributionForPlant;
    rr:objectMap [
      rr:template "http://www.semanticweb.org/plantms/resource/plant/{plant_id}";
      rr:termType rr:IRI
    ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:inRegion;
    rr:objectMap [
      rr:parentTriplesMap <#RegionTriplesMap>;
      rr:joinCondition [ rr:child "region_id"; rr:parent "region_id" ]
    ]
  ] .

<#PlantToDistributionTriplesMap>
  rr:logicalTable [ rr:tableName "plant_distribution" ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/plant/{plant_id}"
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasDistribution;
    rr:objectMap [
      rr:template "http://www.semanticweb.org/plantms/resource/distribution/{plant_id}/{region_id}";
      rr:termType rr:IRI
    ]
  ] .

<#ShopProductTriplesMap>
  rr:logicalTable [ rr:tableName "shop_product" ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/product/{product_id}";
    rr:class plant:ShopProduct
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [ rr:column "product_name" ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasProductId;
    rr:objectMap [ rr:column "product_id"; rr:datatype xsd:integer ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasProductName;
    rr:objectMap [ rr:column "product_name" ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasStockQuantity;
    rr:objectMap [ rr:column "stock_quantity"; rr:datatype xsd:integer ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasPriceEur;
    rr:objectMap [ rr:column "price_eur"; rr:datatype xsd:decimal ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasShelfDate;
    rr:objectMap [ rr:column "shelf_date"; rr:datatype xsd:date ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:isShopProductFor;
    rr:objectMap [
      rr:parentTriplesMap <#PlantTriplesMap>;
      rr:joinCondition [ rr:child "plant_id"; rr:parent "plant_id" ]
    ]
  ] .

<#ShopProductCareLevelTriplesMap>
  rr:logicalTable [
    rr:sqlQuery """
      SELECT product_id, ontology_suffix
      FROM shop_product
      JOIN care_level_dim ON care_level_dim.code = shop_product.care_level_code
    """
  ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/product/{product_id}"
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasCareLevel;
    rr:objectMap [
      rr:template "http://www.semanticweb.org/plantms/ontology#{ontology_suffix}";
      rr:termType rr:IRI
    ]
  ] .

<#ShopProductTemperatureTriplesMap>
  rr:logicalTable [
    rr:sqlQuery """
      SELECT product_id, ontology_suffix
      FROM shop_product
      JOIN temperature_category_dim
        ON temperature_category_dim.code = shop_product.temperature_category_code
    """
  ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/product/{product_id}"
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasTemperatureCategory;
    rr:objectMap [
      rr:template "http://www.semanticweb.org/plantms/ontology#{ontology_suffix}";
      rr:termType rr:IRI
    ]
  ] .

<#PlantToShopProductTriplesMap>
  rr:logicalTable [ rr:tableName "shop_product" ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/plant/{plant_id}"
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasShopProduct;
    rr:objectMap [
      rr:template "http://www.semanticweb.org/plantms/resource/product/{product_id}";
      rr:termType rr:IRI
    ]
  ] .
