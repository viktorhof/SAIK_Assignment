  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [ rr:column "scientific_name" ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:isComponentOf;
    rr:objectMap [
      rr:template "http://www.semanticweb.org/plantms/resource/plant/{plant_id}";
      rr:termType rr:IRI
    ]
  ];
  rr:predicateObjectMap [
    rr:predicate plant:hasFruitConspicuous;
    rr:objectMap [ rr:column "conspicuous"; rr:datatype xsd:boolean ]
  ] .

