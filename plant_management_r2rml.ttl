  rr:logicalTable [
    rr:sqlQuery """
      SELECT plant_id, ontology_suffix
      FROM plant_fruit_color
      JOIN fruit_color_dim ON fruit_color_dim.code = plant_fruit_color.color_code
    """
  ];
  rr:subjectMap [
    rr:template "http://www.semanticweb.org/plantms/resource/fruit/{plant_id}"
  ];
